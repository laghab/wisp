<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network use is limited to the Downloads feature (the :net module), off until the user turns it on, and never used while typing or dictating. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Asked for only when the mic key is first used. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- So the settings can list the apps you can exclude from learning (the launcher's own list; no extra permission). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".SettingsActivity"
            android:process=":settings"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".voice.MicPermissionActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <activity
            android:name=".personal.LearnedDataActivity"
            android:process=":settings"
            android:exported="false" />

        <activity
            android:name=".training.GestureTrainingActivity"
            android:process=":settings"
            android:exported="false" />

        <!-- The speech engine runs in its own process so the model's memory is returned when it exits. -->
        <service
            android:name=".voice.ipc.VoiceService"
            android:process=":voice"
            android:exported="false" />

        <!-- Library start-up hooks (emoji font preloading, lifecycle and profile installers) that no part of Wisp needs: they only cost start time and memory in the keyboard's process. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            tools:node="remove" />

        <!-- Keeps the settings process alive while a download runs; stops itself when nothing is downloading. -->
        <service
            android:name=".downloads.DownloadService"
            android:process=":settings"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:process=":settings"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/update_paths" />
        </provider>

        <service
            android:name=".WispIme"
            android:exported="true"
            android:label="@string/ime_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data android:name="android.view.im" android:resource="@xml/method" />
        </service>
    </application>
</manifest>
